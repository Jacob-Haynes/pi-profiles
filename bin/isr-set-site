#!/usr/bin/env bash
# Set the kit's site-wide settings ONCE (contract v4 C4.1/C4.2) and sync them into every tool.
#
#   sudo isr-set-site --sensor 51.0000,-1.0000          # OP / sensor position (decimal degrees)
#   sudo isr-set-site --sensor 51.0000,-1.0000 --host isr-pi
#   sudo isr-set-site --sync                             # re-sync site.env into every /etc/<repo>.env
#   isr-set-site --show
#
# Writes /etc/isr-kit/site.env (0644, no secrets) and copies ISR_HOST, SENSOR_LAT and SENSOR_LON
# into /etc/<repo>.env for every repo in repos.conf (other keys untouched, mode kept 600).
# Restart running tools afterwards:  sudo pi-profiles --restart
set -euo pipefail
ROOT="${PI_PROFILES_ROOT:-/opt/pi-profiles}"
ETC="${ISR_ETC_DIR:-/etc}"
SITE="${ISR_SITE_ENV:-$ETC/isr-kit/site.env}"
REPOS_CONF="${ISR_REPOS_CONF:-$ROOT/repos.conf}"
KEYS="ISR_HOST SENSOR_LAT SENSOR_LON"
LAT=""; LON=""; HOSTN=""; SHOW=0

while [ $# -gt 0 ]; do
    case "$1" in
        --sensor) v="${2:?--sensor needs LAT,LON}"; LAT="${v%%,*}"; LON="${v#*,}"; shift 2 ;;
        --host) HOSTN="${2:?}"; shift 2 ;;
        --sync) shift ;;   # default behaviour: re-sync current values
        --show) SHOW=1; shift ;;
        -h|--help) sed -n '2,12p' "$0"; exit 0 ;;
        *) echo "unknown option $1" >&2; exit 64 ;;
    esac
done

if [ "$SHOW" -eq 1 ]; then
    [ -f "$SITE" ] && cat "$SITE" || echo "no $SITE"
    exit 0
fi
[ "${ISR_SKIP_ROOT_CHECK:-0}" = "1" ] || [ "$(id -u)" -eq 0 ] || { echo "run as root" >&2; exit 1; }

is_num() { printf '%s' "$1" | grep -Eq '^-?[0-9]{1,3}(\.[0-9]{1,8})?$'; }
if [ -n "$LAT$LON" ]; then
    is_num "$LAT" && is_num "$LON" || { echo "sensor must be LAT,LON in decimal degrees, e.g. 51.0000,-1.0000" >&2; exit 64; }
    awk -v a="$LAT" -v o="$LON" 'BEGIN { exit !(a >= -90 && a <= 90 && o >= -180 && o <= 180 && !(a == 0 && o == 0)) }' \
        || { echo "sensor position out of range (or 0,0, which the contract forbids)" >&2; exit 64; }
fi
case "$HOSTN" in *[!a-z0-9-]*) echo "host must be lowercase [a-z0-9-]" >&2; exit 64 ;; esac

mkdir -p "$(dirname "$SITE")"
get() { [ -f "$SITE" ] && sed -n "s/^$1=//p" "$SITE" | head -1 || true; }
cur_host=$(get ISR_HOST); cur_lat=$(get SENSOR_LAT); cur_lon=$(get SENSOR_LON)
[ -n "$HOSTN" ] || HOSTN="${cur_host:-isr-pi}"
[ -n "$LAT" ] || LAT="$cur_lat"
[ -n "$LON" ] || LON="$cur_lon"

tmp=$(mktemp "$(dirname "$SITE")/.site.env.XXXXXX")
{
    echo "# ISTAR kit site settings (contract v4). Set with: sudo isr-set-site --sensor LAT,LON"
    echo "ISR_HOST=$HOSTN"
    echo "SENSOR_LAT=$LAT"
    echo "SENSOR_LON=$LON"
} > "$tmp"
chmod 644 "$tmp"; mv -f "$tmp" "$SITE"

[ -f "$REPOS_CONF" ] || { echo "wrote $SITE (repos.conf not found, nothing synced)"; exit 0; }
umask 077
n=0
for repo in $(awk '!/^[[:space:]]*(#|$)/ && $4 != "mac" {print $1}' "$REPOS_CONF"); do
    f="$ETC/$repo.env"
    t=$(mktemp "$ETC/.$repo.env.XXXXXX")
    if [ -f "$f" ]; then
        grep -v -E "^[[:space:]]*(export[[:space:]]+)?($(echo "$KEYS" | tr ' ' '|'))=" "$f" > "$t" || true
    fi
    { echo "ISR_HOST=$HOSTN"; echo "SENSOR_LAT=$LAT"; echo "SENSOR_LON=$LON"; } >> "$t"
    chmod 600 "$t"
    [ "$(id -u)" -eq 0 ] && chown root:root "$t"
    mv -f "$t" "$f"
    n=$((n + 1))
done
echo "Wrote $SITE (ISR_HOST=$HOSTN, SENSOR=${LAT:-unset},${LON:-unset}) and synced $n env files."
[ -n "$LAT" ] || echo "NOTE: no sensor position set yet: tools will not place position-bearing CoT. Run: sudo isr-set-site --sensor LAT,LON"
echo "Restart running tools to pick it up:  sudo pi-profiles --restart"
