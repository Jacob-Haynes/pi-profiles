# Old defaults that install.sh wrote into /etc/isr-launcher.env in earlier versions. If a line in
# the live file is EXACTLY one of these, install.sh replaces it with the current default from
# isr-launcher.env.example. A value you set yourself is never touched. Add a line here whenever a
# default in the example changes.
VLM_MODEL=qwen3-vl:8b
LAUNCHER_BIND=0.0.0.0
