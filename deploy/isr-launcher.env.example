# /etc/isr-launcher.env (mode 600). Optional settings for the launcher on :8050.
# PIN required to switch profiles (blank = no PIN; fine on a closed hotspot).
LAUNCHER_PIN=
# Also require the PIN to view the page.
LAUNCHER_PIN_FOR_VIEW=0
LAUNCHER_PORT=8050
# "::" = IPv6 and IPv4 (dual-stack). A Mac on the cable that is also on Wi-Fi reaches the Pi only over IPv6.
LAUNCHER_BIND=::

# Heartbeats: the launcher subscribes to isrkit/heartbeat/+ on the local broker.
# guest works from the Pi itself; change only if RabbitMQ guest is disabled.
LAUNCHER_MQTT_HOST=127.0.0.1
LAUNCHER_MQTT_PORT=1883
LAUNCHER_MQTT_USER=guest
LAUNCHER_MQTT_PASS=guest

# Ollama on the HQ Mac (bare base URL, no path). The launcher probes it and shows the AI tier
# (Mac VLM, then Gemini, then off). Leave blank in Pi-only mode.
LLM_URL=http://isr-hq.local:11434
LLM_MODEL=qwen3.5:27b
VLM_URL=http://isr-hq.local:11434
VLM_MODEL=qwen3-vl:8b-instruct
# Tunnelled HQ (managed Mac, laptop/hq-tunnel.sh): Ollama arrives on the Pi's own 127.0.0.1, so use
#   LLM_URL=http://127.0.0.1:11434  and  VLM_URL=http://127.0.0.1:11434  (sudo ./bootstrap.sh --hq-tunnel sets them).
# While the tunnel is up the launcher relays each tunnelled Mac tool port on every address to
# 127.0.0.1:<port + 10000> (where hq-tunnel.sh puts it). LAUNCHER_TUNNEL_BIND limits it to one address.
LAUNCHER_TUNNEL_FORWARD=1
# Station roles for Macs whose hostname doesn't say it (shown as "HQ Mac" etc. on the board):
# LAUNCHER_STATIONS=corp-laptop-01=hq,another-mac=op
LAUNCHER_STATIONS=
# COP map (/map): one read-only TAK viewer connection to OTS (contract v5; it never sends markers).
LAUNCHER_COP=1
LAUNCHER_TAK_HOST=127.0.0.1
LAUNCHER_TAK_PORT=8087
